// Config
support-for-ie = false
vendor-prefixes = webkit moz ms official

// Colors — remapped to the Commutator design tokens (see css/ds/tokens/colors.css).
// The theme is variable-driven, so pointing these at var(--token) cascades the
// brand through every partial. Change the token files, not these names.
color-default = var(--text-primary)   // ink #17171B
color-grey = var(--text-muted)        // warm grey #7A776F
color-border = var(--border-hair)     // hairline #E7E3DA
color-background = var(--surface-page) // paper #F6F4EF

// Fonts — the brand pairs a display serif with the platform monospace as the
// body face. Headings use font-heading; everything else uses the mono body face.
font-default = var(--font-body)       // platform monospace (brand body face)
font-heading = var(--font-display)    // Marcellus, for titles and the logotype
font-mono = var(--font-mono)
font-sans = var(--font-body)          // was undefined in the theme; map to body
font-icon = FontAwesome
font-icon-path = "fonts/fontawesome-webfont"
font-icon-version = "4.0.3"
font-size = 16px
line-height = 1.75em                   // --leading-body
line-height-title = 1.1em              // --leading-display

// Header
logo-size = 40px
subtitle-size = 16px

// Layout
block-margin = 50px
mobile-nav-width = 280px

// Media queries
mq-large = "screen and (min-width: 1400px)"
mq-normal = "screen and (min-width: 840px)"
mq-mobile = "screen and (max-width: 839px)"